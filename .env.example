# Alles optional. Ohne SMTP_URL landen Mails (inkl. Login-Links) im Terminal von `npm run dev`.
DATABASE_URL=file:local.db
AUTH_SECRET=            # z. B. `openssl rand -base64 32`
APP_URL=http://localhost:3000
SMTP_URL=               # z. B. smtps://user:pass@smtp.example.com:465
MAIL_FROM=Handwerkertermine <noreply@example.com>
