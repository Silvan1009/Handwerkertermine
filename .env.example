# Alles optional in der Entwicklung. In Produktion: AUTH_SECRET, APP_URL, SMTP_URL setzen.
DATABASE_URL=file:local.db
AUTH_SECRET=            # z. B. `openssl rand -base64 32`
APP_URL=http://localhost:3000
SMTP_URL=               # z. B. smtps://user:pass@smtp.example.com:465 – leer = Mails in der Konsole
MAIL_FROM=Handwerkertermine <noreply@example.com>
