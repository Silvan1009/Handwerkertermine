# Entwicklung: alles optional. Produktion: AUTH_SECRET, APP_URL und SMTP_URL sind Pflicht
# (ohne startet der Login nicht bzw. Mails schlagen mit klarem Log-Eintrag fehl).
DATABASE_URL=file:local.db
AUTH_SECRET=            # z. B. `openssl rand -base64 32`
APP_URL=http://localhost:3000
SMTP_URL=               # z. B. smtps://user:pass@smtp.example.com:465 – leer = Mails in der Konsole (nur Entwicklung)
MAIL_FROM=Handwerkertermine <noreply@example.com>
